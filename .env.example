# Copy to .env.local for local dev. Set the same vars in Vercel for production.
# Anything prefixed NEXT_PUBLIC_ is exposed to the browser. Everything else is server-only.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
# Service role key — server-only. Used by /api/refer to insert leads on behalf of an agent
# without requiring auth from the public referral form. Treat like a database password.
SUPABASE_SERVICE_ROLE_KEY=ey...

# --- Anthropic (required for AI Copilot drafts & voice extraction) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Twilio (LEGACY — no longer required) ---
# Brikk moved off Twilio SMS in favor of native `sms:` deep links: agents send
# messages from their own phone, Brikk auto-logs the conversation. This sidesteps
# A2P 10DLC registration and TCPA risk. The /api/sms route still exists but is
# not used by the app. Leave these unset unless you intentionally re-enable
# server-side SMS sending.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+15555550123

# --- Stripe (required for billing) ---
# In production use a RESTRICTED key (rk_live_...) with only the scopes Brikk
# needs: Checkout Sessions Write, Customers Write, Subscriptions Write, Customer
# Portal Write, Prices Read, Products Read, Invoices Read, Setup Intents Write.
# Everything else None. Don't use the unrestricted sk_live_ in production.
STRIPE_SECRET_KEY=rk_live_...
# Signing secret for the /api/stripe/webhook endpoint. Verifies that incoming
# webhook calls really came from Stripe. Get this from Stripe Dashboard →
# Developers → Webhooks → click your endpoint → Signing secret (Reveal).
STRIPE_WEBHOOK_SECRET=whsec_...
# Apple Pay domain verification file content. Download from Stripe Dashboard →
# Settings → Payment Methods → Apple Pay → Add Domain → Download verification
# file → paste entire contents as single line. Brikk serves it from
# /.well-known/apple-developer-merchantid-domain-association.
APPLE_PAY_DOMAIN_ASSOCIATION=
# Set to "true" only after Nathan registers Brikk for sales tax in Stripe Tax.
# Until then leave unset, otherwise every checkout errors.
# STRIPE_ENABLE_TAX=true

# --- Resend (required for branded transactional emails — lead confirmations + morning brief) ---
# Get from resend.com → API Keys → Create API Key.
# Note: signup confirmation emails go through Supabase's SMTP config (also Resend, but configured in Supabase dashboard, not here).
RESEND_API_KEY=re_...
# Optional — domain used for the From address. Defaults to brikk.store.
RESEND_FROM_DOMAIN=brikk.store

# --- Cron secret (Vercel cron auth) ---
# Generate a random string (32+ characters). Vercel passes this in Authorization
# header so only Vercel's cron can trigger /api/cron/morning-brief.
CRON_SECRET=replace-with-a-long-random-string

# Optional override — defaults to https://brikk.store
NEXT_PUBLIC_APP_URL=https://brikk.store
